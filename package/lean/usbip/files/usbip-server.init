#!/bin/sh /etc/rc.common
# Copyright (C) 2006-2011 OpenWrt.org

START=90
STOP=10

USE_PROCD=1
PROG=/usr/sbin/usbipd

start_service() {
    # 加载USB/IP内核模块
    insmod usbip-core
    insmod usbip-vudc
    insmod usbip-host

    # 创建37个虚拟USB节点
    for i in $(seq 0 36); do
        if [ ! -e /dev/usbip_vudc$i ]; then
            mknod /dev/usbip_vudc$i c 180 $((200 + i))
            chmod 666 /dev/usbip_vudc$i
        fi
    done

    # 启动USB/IP服务器，监听所有接口
    procd_open_instance
    procd_set_param command $PROG -D
    procd_set_param respawn
    procd_close_instance

    # 设置端口转发（3240-3276对应37个节点）
    for port in $(seq 3240 3276); do
        iptables -I INPUT -p tcp --dport $port -j ACCEPT
    done
}

stop_service() {
    # 停止服务
    killall $PROG

    # 移除防火墙规则
    for port in $(seq 3240 3276); do
        iptables -D INPUT -p tcp --dport $port -j ACCEPT
    done

    # 卸载模块
    rmmod usbip-host
    rmmod usbip-vudc
    rmmod usbip-core
}
